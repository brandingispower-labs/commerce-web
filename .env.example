# ── 사이트 표시값 (APP/02 가 정한 값) ─────────────────────────────
COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"

# ── 주소 · 포트 ─────────────────────────────────────────────────
# BASE_URL 은 lib/utils.ts 의 baseUrl 이 읽고, metadataBase · robots.txt ·
# sitemap.xml 이 그 값을 쓴다.
BASE_URL="http://localhost:3000"
# 이미지의 기본값은 Dockerfile 의 ENV PORT=3000 (APP/03).
PORT=3000

# ── commerce-api 연결 ───────────────────────────────────────────
# NEXT_PUBLIC_ 접두사를 쓰지 않는다: 값이 번들에 박히면 환경마다 이미지가 달라진다.
MEDUSA_BACKEND_URL="http://localhost:9000"
MEDUSA_PUBLISHABLE_KEY=""
MEDUSA_REVALIDATION_SECRET=""

# ── 계측 (비우면 register() 가 계측을 켜지 않는다) ────────────────
OTEL_SERVICE_NAME="commerce-web"
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL="grpc"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=""
OTEL_RESOURCE_ATTRIBUTES=""
